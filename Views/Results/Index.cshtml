@model ResultListViewModel
@{ ViewData["Title"] = "Results & Marks"; }
<div class="page-actions">
    <p class="muted">@Model.Results.TotalCount result(s) found</p>
    <div class="toolbar">
        <a class="btn btn-outline" asp-controller="Reports" asp-action="Results">Results Report</a>
        <a class="btn btn-primary" asp-action="Create">+ Enter Result</a>
    </div>
</div>
<form class="card toolbar" method="get" asp-action="Index">
    <div class="field"><label for="examId">Examination</label><select class="input" id="examId" name="examId" asp-items="Model.Exams"><option value="">All examinations</option></select></div>
    <div class="field"><label for="q">Student</label><input class="input" id="q" type="search" name="q" value="@Model.Q" placeholder="Name or ID" /></div>
    <div class="field"><label for="outcome">Outcome</label>
        <select class="input" id="outcome" name="outcome">
            <option value="">Pass and fail</option>
            <option value="pass" selected="@(Model.Outcome == "pass")">Passed</option>
            <option value="fail" selected="@(Model.Outcome == "fail")">Failed</option>
        </select></div>
    <button class="btn btn-primary" type="submit">Filter</button>
    <a class="btn btn-outline" asp-action="Index">Reset</a>
</form>
<section class="card">
@if (!Model.Results.Any()) { <div class="empty">No results found. Create an examination, then enter marks.</div> }
else
{
    <div class="table-wrap"><table class="table">
        <thead><tr><th>Student</th><th>Examination</th><th>Marks</th><th>%</th><th>Grade</th><th>Result</th><th class="right">Actions</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Results)
        {
            <tr><td>@r.Student?.StudentCode - @r.Student?.FullName</td>
                <td>@r.Examination?.Name</td>
                <td>@r.MarksObtained / @r.Examination?.MaxMarks</td>
                <td>@r.Percentage.ToString("0.##")</td>
                <td>@r.Grade</td>
                <td><span class="badge @UiHelper.StatusBadge(r.Passed ? "Pass" : "Fail")">@(r.Passed ? "Pass" : "Fail")</span></td>
                <td class="right actions">
                    <a class="link" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="inline" data-confirm="Delete this result?">
                        <button type="submit" class="link danger">Delete</button></form>
                </td></tr>
        }
        </tbody></table></div>
    <nav class="pager" aria-label="Pagination">
        @if (Model.Results.HasPrevious)
        {
            <a class="btn btn-outline" asp-action="Index" asp-route-page="@(Model.Results.PageIndex - 1)" asp-route-examId="@Model.ExamId" asp-route-q="@Model.Q" asp-route-outcome="@Model.Outcome">Previous</a>
        }
        <span>Page @Model.Results.PageIndex of @Model.Results.TotalPages</span>
        @if (Model.Results.HasNext)
        {
            <a class="btn btn-outline" asp-action="Index" asp-route-page="@(Model.Results.PageIndex + 1)" asp-route-examId="@Model.ExamId" asp-route-q="@Model.Q" asp-route-outcome="@Model.Outcome">Next</a>
        }
    </nav>
}
</section>
