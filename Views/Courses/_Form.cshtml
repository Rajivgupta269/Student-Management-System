@model Course
<div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
<div class="form-grid">
    <div class="field"><label asp-for="Code"></label><input asp-for="Code" class="input" /><span asp-validation-for="Code" class="field-error"></span></div>
    <div class="field"><label asp-for="Name"></label><input asp-for="Name" class="input" /><span asp-validation-for="Name" class="field-error"></span></div>
    <div class="field"><label asp-for="DepartmentId"></label>
        <select asp-for="DepartmentId" class="input" asp-items="(SelectList)ViewBag.Departments"><option value="0">Select department</option></select>
        <span asp-validation-for="DepartmentId" class="field-error"></span></div>
    <div class="field"><label asp-for="DurationYears"></label><input asp-for="DurationYears" type="number" min="1" max="6" class="input" /><span asp-validation-for="DurationYears" class="field-error"></span></div>
    <div class="field"><label asp-for="IsActive">Status</label>
        <select asp-for="IsActive" class="input"><option value="true">Active</option><option value="false">Inactive</option></select></div>
    <div class="field full"><label asp-for="Description"></label><textarea asp-for="Description" rows="3" class="input"></textarea><span asp-validation-for="Description" class="field-error"></span></div>
</div>
