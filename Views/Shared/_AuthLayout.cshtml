<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ScholarHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-wrap">
        <div class="auth-brand">
            <svg viewBox="0 0 40 40" width="56" height="56" aria-hidden="true">
                <rect width="40" height="40" rx="10" fill="#15803D"/>
                <path d="M20 10 7 16.5 20 23l13-6.5L20 10Z" fill="#fff"/>
                <path d="M13 20.5v5c0 1.5 3.1 3.5 7 3.5s7-2 7-3.5v-5L20 24l-7-3.5Z" fill="#22C55E"/>
                <rect x="32" y="17" width="2" height="9" rx="1" fill="#fff"/>
            </svg>
            <h1>ScholarHub</h1>
            <p>Smarter Campus. Better Learning.</p>
        </div>
        @RenderBody()
    </main>
</body>
</html>
