@model Department
@{ ViewData["Title"] = "Add Department"; }
<form class="card" asp-action="Create" method="post">
    <partial name="_Form" model="Model" />
    <div class="form-actions"><button class="btn btn-primary" type="submit">Save Department</button><a class="btn btn-outline" asp-action="Index">Cancel</a></div>
</form>
